# Copie ce fichier en ".env" (sans .example) à la racine du projet,
# et remplis tes vraies valeurs.
# Source : sur ton instance Docker, dans le fichier .env du déploiement
# (dossier supabase/docker/), variables ANON_KEY et l'URL de l'API (Kong).
#
# ⚠️ Le préfixe "EXPO_PUBLIC_" est obligatoire pour qu'Expo rende
# ces variables accessibles dans le code de l'application.
# ⚠️ N'utilise jamais la SERVICE_ROLE_KEY ici (voir Module 11 du cours).

EXPO_PUBLIC_SUPABASE_URL=http://192.168.11.65:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=ta_cle_anon_ici
EXPO_PUBLIC_STADIA_API_KEY=ta clé stadia ici
